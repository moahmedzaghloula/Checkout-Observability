# Safe local defaults. Copy to .env only if your shell tooling loads it.
APP_ENV=development
INVENTORY_API_URL=http://127.0.0.1:8001
INVENTORY_HTTP_TIMEOUT_SECONDS=2.0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics

# Compose reads the password from this ignored local file.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD_FILE=./.local-secrets/grafana_admin_password

# Simulated latency and failures require both APP_ENV=local and this flag.
ENABLE_LOCAL_SIMULATIONS=false
SIMULATED_DELAY_SECONDS=1.0
